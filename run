#!/usr/bin/env bash
# Single host entry point for every containerized operation:
#
#   ./run <command> [args...]
#
# Commands: all ingest etl serve gen status clean test figures
#
# Every command takes -h/--help, and validates its arguments and preconditions
# (via the Python gate, `fly status --check`, the single source of truth) before
# doing anything — an unknown argument, an out-of-order stage, or a missing
# prerequisite prints the reason plus usage and exits without side effects.
set -euo pipefail
cd "$(dirname "$0")"
source .rebuild

# --- shared helpers ----------------------------------------------------------
# Each command sets usage() to its own heredoc before calling these.

top_usage() {
    cat <<'EOF'
usage: ./run <command> [args...]

Build pipeline (run in this order):
  gen [target...]     build data/build/lookup/ lookup assets (bare = all)
  ingest [sub]        download raw ADS-B (bare); or merge-batches | downsample
  etl [stage...]      run the pipeline (bare = all stages)
  serve               build + serve data/out/ at http://127.0.0.1:8150

Other:
  all                 ingest -> etl -> serve, end to end
  status              report pipeline state
  clean               remove data/build/lookup/ + data/out/data/
  test [suite] [NAME...]  run the test suites (bare = backend + frontend)
  figures             re-render the static figures the site ships

Run `./run <command> --help` for command-specific help.
EOF
}

help_or_usage() {
    # Every arg, so `./run etl types --help` prints help too.
    local a
    for a in "$@"; do
        case "$a" in -h|--help|help) usage; exit 0 ;; esac
    done
}

# Remove dead one-off containers left by interrupted `docker compose run
# --rm` invocations (they trigger "found orphan containers" warnings and
# accumulate forever otherwise). The oneoff label scopes this precisely
# to compose-run instances of THIS project — persistent service
# containers (frontend, wireguard) are never matched. Best-effort: never
# blocks the actual command.
reap_oneoffs() {
    # _project() (defined in .rebuild, sourced above) reads the `name:`
    # key from docker-compose.yml — the same source of truth .rebuild
    # itself uses to tag images (<project>-<service>). Deriving it here
    # instead of hard-coding "fly" keeps the two from silently drifting
    # apart if the compose project is ever renamed.
    docker ps -aq \
        --filter "label=com.docker.compose.project=$(_project)" \
        --filter "label=com.docker.compose.oneoff=True" \
        --filter "status=exited" --filter "status=created" \
        2>/dev/null | xargs -r docker rm >/dev/null 2>&1 || true
}


# Escape one string for literal inclusion in the JS-flavored regex Playwright
# builds from `-g`/`--grep` (`new RegExp(pattern)`). Used so NAME args to
# `./run test frontend` are matched as plain substrings even if they contain
# regex metacharacters (a test title like "What-If (2h)" would otherwise be
# parsed as a regex, not matched literally).
escape_regex() {
    local s="$1" out="" c i
    for (( i=0; i<${#s}; i++ )); do
        c="${s:i:1}"
        case "$c" in
            '.'|'*'|'+'|'?'|'^'|'$'|'('|')'|'['|']'|'{'|'}'|'|'|'\')
                out+="\\$c" ;;
            *)
                out+="$c" ;;
        esac
    done
    printf '%s' "$out"
}

reject_extra_args() {
    if [ "$#" -gt 0 ]; then
        echo "error: unexpected argument(s): $*" >&2
        echo >&2
        usage >&2
        exit 1
    fi
}

# Run the Python precondition gate in the etl container; on any failure append
# the command's usage and exit 1. Assumes the etl image exists.
gate() {
    if ! docker compose run --rm etl status --check "$@"; then
        echo >&2
        usage >&2
        exit 1
    fi
}

# --- commands ----------------------------------------------------------------

cmd_gen() {
    usage() { cat <<'EOF'
usage: ./run gen [mil|airports|raster|boundaries|roles ...]

  (no args)   build every pipeline-consumed asset in dependency order:
              mil, airports, raster, boundaries, roles.
  mil         data/build/lookup/mil_icao24.txt (US-military icao24 list)
  airports    airports.pkl
  raster      airspace raster + iso lookups
  boundaries  boundaries.geojson
  roles       roles.html + roles.reference.json (aircraft-role reference)
EOF
    }
    help_or_usage "$@"
    ensure_build etl
    gate gen "$@"
    if [ "$#" -eq 0 ]; then
        docker compose run --rm etl gen
    else
        # `fly gen` is a click group (one target per call), so run each in turn.
        for target in "$@"; do docker compose run --rm etl gen "$target"; done
    fi
}

cmd_ingest() {
    usage() { cat <<'EOF'
usage: ./run ingest [--direct] [merge-batches | downsample [--interval N --backup-dir D --start D --end D]]

  (no args)       generate the mil list, then download + filter raw ADS-B
                  into data/build/ingest/ (tunneled; hours; idempotent).
  merge-batches   recover after an interrupted ingest: finalize leftover
                  trace batches into trace.parquet without re-downloading.
  downsample      thin already-stored raw traces to reclaim disk.
                  --start/--end override the configured analysis window
                  to reach partitions outside it.

  --direct        this invocation only: no WireGuard tunnel. Downloads
                  leave with this machine's own address, which GitHub
                  logs. Needs no data/in/wg/wg0.conf. Must come first.
EOF
    }
    help_or_usage "$@"
    local direct=0
    if [ "${1:-}" = "--direct" ]; then
        direct=1
        shift
    fi
    # Gate (validates the sub-token; checks source files for a fresh download)
    # runs in the etl container; the work runs in the tunneled ingest container.
    # Only the first token names the sub-command, so the gate validates just it.
    ensure_build etl
    gate ingest ${1:+"$1"}
    ensure_build wireguard ingest
    # The sidecar is recreated on every invocation so it is always in the
    # mode asked for now, never one left over from an earlier run.
    ingest_refuse_if_running
    if [ "$direct" = 1 ]; then
        cat >&2 <<'EOF'
WARNING: --direct: no tunnel for this run. The adsb.lol archives are
fetched from GitHub, which will log this machine's address.
EOF
        export FLY_NET_DIRECT=1
        # Remove the direct sidecar when this command ends, however it ends,
        # so a later bare `docker compose run ingest` cannot reuse it.
        trap 'docker compose rm -sf wireguard >/dev/null 2>&1 || true' EXIT
    else
        export FLY_NET_DIRECT=0
    fi
    docker compose up -d --force-recreate --wait --wait-timeout 90 wireguard
    case "${1:-}" in
        "")            docker compose run --rm ingest ;;
        merge-batches) docker compose run --rm ingest run merge-batches ;;
        downsample)    shift; docker compose run --rm ingest run downsample "$@" ;;
        *)             usage >&2; exit 1 ;;   # unreachable: gate rejected $1
    esac
}

# Recreating the shared sidecar would pull the network namespace out from
# under an ingest already running from this or any other checkout (they all
# share the compose project name). Refuse in that case.
ingest_refuse_if_running() {
    local running
    running=$(docker ps -q \
        --filter "label=com.docker.compose.project=$(_project)" \
        --filter "label=com.docker.compose.service=ingest" \
        --filter "status=running" 2>/dev/null)
    if [ -n "$running" ]; then
        echo "error: an ingest container is already running; --direct would" >&2
        echo "       recreate the sidecar under it. Wait for it or stop it first." >&2
        exit 1
    fi
}

cmd_etl() {
    usage() { cat <<'EOF'
usage: ./run etl [STAGE...]

Run the etl pipeline. With no arguments runs all stages in order. The final
stage (export) writes the generated site data directly into data/out/data/
(config in data/in/config/frontend/ is git-tracked and edited directly,
then copied in by the frontend build; see vite.config.js). Pass phase
groups or stage names (strictly in pipeline order) to run a subset.

  phases:  preprocess  timeline  landing  publish
  stages:  types denoise                                          (preprocess)
           partition edge split flight                            (timeline)
           train attribute theater                                (landing)
           trace export                                           (publish)

examples:
  ./run etl                     all stages
  ./run etl timeline            just the timeline phase
  ./run etl split flight        two stages, in pipeline order
EOF
    }
    help_or_usage "$@"
    ensure_build etl
    gate etl "$@"
    docker compose run --rm etl run etl "$@"
}

cmd_serve() {
    usage() { cat <<'EOF'
usage: ./run serve

Build the frontend and serve data/out/ at http://127.0.0.1:8150.
Watches for source changes and rebuilds automatically. Runs forever;
Ctrl-C to stop. Takes no arguments. Needs a prior ETL run
(data/out/data/ must exist).
EOF
    }
    help_or_usage "$@"
    reject_extra_args "$@"
    ensure_build frontend
    gate serve
    docker compose rm -sf frontend 2>/dev/null || true
    docker compose up frontend
}

cmd_status() {
    usage() { cat <<'EOF'
usage: ./run status

Report pipeline state: config, source/generated/raw/etl/build files, and
docker containers, with fix-it hints. Takes no arguments.
EOF
    }
    help_or_usage "$@"
    reject_extra_args "$@"
    ensure_build etl
    docker compose run --rm etl status
}

cmd_clean() {
    usage() { cat <<'EOF'
usage: ./run clean

Remove data/build/lookup/ and the generated site data (data/out/data/ only,
not the built frontend app alongside it; keeps data/build/ingest/,
data/in/external/, and data/in/config/frontend/). Prompts for
confirmation. No arguments.
EOF
    }
    help_or_usage "$@"
    reject_extra_args "$@"
    ensure_build etl
    docker compose run --rm etl clean
}

cmd_test_backend() {
    usage() { cat <<'EOF'
usage: ./run test backend [NAME...]

Run the pytest suite in the etl container. With no NAME arguments runs
the full suite (test/backend/, via pyproject.toml's testpaths).

Each NAME resolves independently: a module short name (`roles` ->
test/backend/test_roles.py), a path under test/backend/, or any pytest
node id / -k expression — passed through verbatim when neither of the
above matches, so `test_roles.py::test_x` or a `-k` expression works.
EOF
    }
    help_or_usage "$@"
    ensure_build etl
    local args=() name
    for name in "$@"; do
        if [ -f "test/backend/test_${name}.py" ]; then
            args+=("test/backend/test_${name}.py")
        elif [ -e "test/backend/${name}" ]; then
            args+=("test/backend/${name}")
        else
            args+=("$name")
        fi
    done
    # ${args[@]+"${args[@]}"} (not bare "${args[@]}"): under `set -u`, bash
    # < 4.4 (e.g. macOS's system bash 3.2) treats expanding an EMPTY array
    # with "${arr[@]}" as an unbound-variable error. args is empty whenever
    # no NAME was given, so the bare form breaks the plain `./run test
    # backend` case on those shells. The + form skips the expansion
    # entirely when the array is empty, on every bash version.
    docker compose run --rm --entrypoint python etl -m pytest -q -p no:cacheprovider ${args[@]+"${args[@]}"}
}

cmd_test_frontend() {
    usage() { cat <<'EOF'
usage: ./run test frontend [NAME...]

Run the Playwright browser suite in the playwright container, against
the running frontend service (start it first with `./run serve`).

NAME is a test-title substring, matched literally (any regex
metacharacters in it are escaped, so e.g. a title containing
parentheses still matches as plain text); multiple NAMEs are OR-ed
into one -g regex (`./run test frontend tour whatif` -> tests matching
"tour" or "whatif").
EOF
    }
    help_or_usage "$@"
    ensure_build playwright
    if ! docker compose ps --status=running --services | grep -qx frontend; then
        echo "error: the frontend service isn't running — start it first with './run serve'" >&2
        exit 1
    fi
    # Pre-flight from inside the test container: a running frontend on the
    # wrong port otherwise surfaces only as ERR_CONNECTION_REFUSED deep in
    # the first test.
    if ! docker compose run --rm --no-deps -T playwright node -e '
        const url = process.env.BASE_URL + "/";
        fetch(url).then(r => { if (!r.ok) throw new Error("HTTP " + r.status); })
          .catch(e => { console.error("error: frontend not reachable at " + url + " (" + e.message + ")"); process.exit(1); });
    '; then
        exit 1
    fi
    if [ "$#" -gt 0 ]; then
        local pattern="" name esc
        for name in "$@"; do
            esc="$(escape_regex "$name")"
            if [ -z "$pattern" ]; then pattern="$esc"; else pattern="$pattern|$esc"; fi
        done
        docker compose run --rm playwright npx playwright test -g "$pattern"
    else
        docker compose run --rm playwright npx playwright test
    fi
}

cmd_figures() {
    usage() { cat <<'EOF'
usage: ./run figures

Re-render the static figures the site ships, from the running app, into
frontend/src/static/ for the next build. Needs the frontend service
running (`./run serve`). Each script under frontend/figures/ renders one
figure in the playwright container; currently tour-corridor.jpg, the
phone tour's Europe-wide corridor picture.
EOF
    }
    help_or_usage "$@"
    reject_extra_args "$@"
    ensure_build playwright
    if ! docker compose ps --status=running --services | grep -qx frontend; then
        echo "error: the frontend service isn't running — start it first with './run serve'" >&2
        exit 1
    fi
    local script
    for script in frontend/figures/*.mjs; do
        docker compose run --rm playwright node "$script"
    done
    echo "rebuild with ./run serve to ship the new figures"
}

cmd_test() {
    usage() { cat <<'EOF'
usage: ./run test [backend|frontend] [NAME...]

  (no args)           run both suites: backend, then frontend
  backend [NAME...]   pytest, in the etl container
  frontend [NAME...]  Playwright, in the playwright container

Run `./run test backend --help` or `./run test frontend --help` for
NAME-filtering details specific to each suite.
EOF
    }
    # Only scan for -h/--help/help here when $1 isn't "backend"/"frontend":
    # those delegate to cmd_test_backend/cmd_test_frontend below, which
    # scan their OWN remaining args and print their own, more specific
    # usage. Scanning unconditionally here (now that help_or_usage checks
    # every arg, not just $1) would catch e.g. the --help in `./run test
    # frontend --help` too early and print this generic usage instead of
    # cmd_test_frontend's.
    case "${1:-}" in
        backend|frontend) ;;
        *) help_or_usage "$@" ;;
    esac
    case "${1:-}" in
        backend)  shift; cmd_test_backend "$@" ;;
        frontend) shift; cmd_test_frontend "$@" ;;
        "")
            local backend_ok=0 frontend_ok=0
            cmd_test_backend || backend_ok=1
            cmd_test_frontend || frontend_ok=1
            echo
            [ "$backend_ok" -eq 0 ]  && echo "backend:  passed" || echo "backend:  FAILED"
            [ "$frontend_ok" -eq 0 ] && echo "frontend: passed" || echo "frontend: FAILED"
            [ "$backend_ok" -eq 0 ] && [ "$frontend_ok" -eq 0 ]
            ;;
        *)
            echo "error: unknown test suite '$1'" >&2
            echo >&2
            usage >&2
            exit 1
            ;;
    esac
}


cmd_all() {
    usage() { cat <<'EOF'
usage: ./run all

Run the full build end to end: ingest -> etl -> serve. Each step gates its own
preconditions. Ends in serve, which runs forever (Ctrl-C to stop). Takes no
arguments.
EOF
    }
    help_or_usage "$@"
    reject_extra_args "$@"
    ./run ingest
    ./run etl
    ./run serve
}

# --- dispatch ----------------------------------------------------------------
usage() { top_usage; }   # default usage for the top-level error paths
reap_oneoffs
case "${1:-}" in
    "")             top_usage >&2; exit 1 ;;
    -h|--help|help) top_usage; exit 0 ;;
    all)            shift; cmd_all "$@" ;;
    ingest)         shift; cmd_ingest "$@" ;;
    etl)            shift; cmd_etl "$@" ;;
    serve)          shift; cmd_serve "$@" ;;
    gen)            shift; cmd_gen "$@" ;;
    status)         shift; cmd_status "$@" ;;
    clean)          shift; cmd_clean "$@" ;;
    test)           shift; cmd_test "$@" ;;
    figures)        shift; cmd_figures "$@" ;;
    *)              echo "error: unknown command '$1'" >&2; echo >&2; top_usage >&2; exit 1 ;;
esac
